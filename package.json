{
  "name": "cofun",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "knip": "knip",
    "use-cases": "pnpm --silent --filter cofun-scripts use-cases",
    "format:fix": "oxfmt --write '**/*.{ts,tsx,json,css}'",
    "format:check": "oxfmt --check '**/*.{ts,tsx,json,css}'",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter cofun-extension build",
    "test": "pnpm -r test",
    "browser-driver": "pnpm --silent --filter cofun-extension browser-driver",
    "test:browser": "pnpm build && pnpm --silent --filter cofun-extension test:browser",
    "media": "pnpm --silent --filter cofun-scripts media",
    "icons": "pnpm --silent --filter cofun-extension icons",
    "check": "pnpm lint && pnpm knip && pnpm format:check && pnpm use-cases && pnpm typecheck && pnpm build && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "oxfmt": "~0.78.0",
    "oxlint": "^1.93.0"
  },
  "packageManager": "pnpm@11.1.2"
}
