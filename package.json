{
  "name": "notion-copilot",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format:fix": "oxfmt --write '**/*.{ts,tsx,json,css}'",
    "format:check": "oxfmt --check '**/*.{ts,tsx,json,css}'",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter notion-copilot-extension build",
    "test": "pnpm -r test",
    "e2e": "pnpm --silent --filter notion-copilot-e2e e2e",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "~0.77.0",
    "oxlint": "^1.92.0"
  },
  "packageManager": "pnpm@11.1.2"
}
