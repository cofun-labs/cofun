// The module boundaries of the extensions and the packages they share (AGENTS.md: "Architecture" and "Calling outside services"), as lint errors.
// Oxlint's default rules stay on: this file only adds rules.
//
// Each rule is written once for every extension, with extensions/*/ globs: an extension is
// extensions/<name>/, and it reaches its site only through src/<site>/tab.ts (src/notion/tab.ts in
// Notico).
//
// An override replaces a rule's whole configuration, it does not merge with the one before it. So
// each block below repeats the restrictions that still hold for its files, and a later block wins.
//
// Oxlint's regexes have no lookahead (a pattern with one is ignored without a warning), so the rule
// that an extension never imports another one is written per place: in src/, a relative path that
// climbs to another folder's src/ or test/ (src/ is up to two levels deep, so the depth is not
// known); in test/ and browser-test/, a path that climbs two levels, to the extensions/ folder (the
// worker, which tests run against, is three levels up); in the extension's root files, one level. A package
// name can't reach another extension: no extension depends on another, and pnpm resolves only
// declared dependencies.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // Everywhere in the repository, tests included. packages/agent/src/ is exempted below for pi, and
    // packages/analytics/src/index.ts for the PostHog SDK.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@earendil-works/pi-agent-core",
              "@earendil-works/pi-agent-core/**",
              "@earendil-works/pi-ai",
              "@earendil-works/pi-ai/**"
            ],
            "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
          },
          {
            "group": ["posthog-js", "posthog-js/**"],
            "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["extensions/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // An extension's own root files (manifest.ts, vite.config.ts, vitest.config.ts): one level
      // up is extensions/.
      "files": ["extensions/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["@cofun/analytics"],
                "message": "Only an extension's src/analytics.ts uses @cofun/analytics: it lists the extension's events. Call its track()."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^\\.\\./[^./]",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // An extension's tests, which sit directly in test/ (vitest) and browser-test/ (Playwright).
      "files": ["extensions/*/test/**", "extensions/*/browser-test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["@cofun/analytics"],
                "message": "Only an extension's src/analytics.ts uses @cofun/analytics: it lists the extension's events. Call its track()."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^\\.\\./\\.\\./[^./]",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["extensions/*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cofun/worker-client"],
                "allowTypeImports": true,
                "message": "Only the side panel's state (panel.ts, chat-session.ts) calls the worker: it gives the agent the client through @cofun/agent's hostedProvider and workerWeb, which turn a request the worker turned away into a stop of the question, and count what a call cost. Import its types only, or ask the agent (ToolContext.readWeb, searchWeb). Clerk sign-in is '@cofun/worker-client/clerk', and the credits in words '@cofun/worker-client/credits'."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["@cofun/analytics"],
                "message": "Only an extension's src/analytics.ts uses @cofun/analytics: it lists the extension's events. Call its track()."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "group": ["@cofun/panel-test", "@cofun/panel-test/**"],
                "message": "@cofun/panel-test is the side panel's UI test harness: only an extension's tests and vitest.config.ts use it."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site; a model is called through @cofun/agent, and the worker through @cofun/worker-client. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "Only an extension's src/<site>/tab.ts uses chrome.scripting: it is how requests run inside the user's tab. Use the helpers tab.ts exports."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site; a model is called through @cofun/agent, and the worker through @cofun/worker-client. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site; a model is called through @cofun/agent, and the worker through @cofun/worker-client. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site; a model is called through @cofun/agent, and the worker through @cofun/worker-client. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ]
      }
    },
    {
      // The side panel's state outside React: one ChatSession per chat, and the Panel that holds the
      // open one. React subscribes to them, so they import no React, nor anything that renders. They
      // are the modules that call the worker: the Panel reads the credits and opens Checkout, and both
      // give the client to the agent. Their other restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/sidepanel/chat-session.ts", "extensions/*/src/sidepanel/panel.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "@clerk/chrome-extension",
                  "@clerk/chrome-extension/**"
                ],
                "message": "The side panel's ChatSession and Panel import no React: React subscribes to them (subscribe, getSnapshot). Keep what renders in the components."
              },
              {
                "regex": "^\\./[A-Z]",
                "message": "The side panel's ChatSession and Panel import no component (the side panel's modules named with a capital): a type both use goes in chat-session.ts or panel.ts."
              },
              {
                "group": ["./icons", "./menu", "./main"],
                "message": "The side panel's ChatSession and Panel import no React: these side-panel modules render or are hooks. A type both use goes in chat-session.ts or panel.ts."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["@cofun/analytics"],
                "message": "Only an extension's src/analytics.ts uses @cofun/analytics: it lists the extension's events. Call its track()."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "group": ["@cofun/panel-test", "@cofun/panel-test/**"],
                "message": "@cofun/panel-test is the side panel's UI test harness: only an extension's tests and vitest.config.ts use it."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The site layer knows nothing about the agent, the tools, sessions, or the UI. One directory
      // per site: src/sidepanel/ sits next to them and is not one, so each site is named here
      // (Notion in Notico, Confluence in Confluco). The site layers for a page in any tab and for
      // DuckDuckGo are @cofun/tools's, whose own block is below.
      "files": ["extensions/*/src/notion/**", "extensions/confluco/src/confluence/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cofun/worker-client"],
                "allowTypeImports": true,
                "message": "Only the side panel's state (panel.ts, chat-session.ts) calls the worker: it gives the agent the client through @cofun/agent's hostedProvider and workerWeb, which turn a request the worker turned away into a stop of the question, and count what a call cost. Import its types only, or ask the agent (ToolContext.readWeb, searchWeb). Clerk sign-in is '@cofun/worker-client/clerk', and the credits in words '@cofun/worker-client/credits'."
              },
              {
                "group": ["@cofun/agent", "@cofun/tools"],
                "message": "An extension's site layer imports nothing from the agent (@cofun/agent) or the shared tools (@cofun/tools): the agent and the tools depend on the site layer, not the other way round."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["@cofun/analytics"],
                "message": "Only an extension's src/analytics.ts uses @cofun/analytics: it lists the extension's events. Call its track()."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^(\\.\\./)+(tool|tools|sessions|sidepanel)(\\.|/|$)",
                "message": "An extension's site layer (src/notion/ in Notico, src/confluence/ in Confluco) imports nothing from tool.ts, tools/, sessions.ts, or sidepanel/: those modules depend on the site layer, not the other way round."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "group": ["@cofun/panel-test", "@cofun/panel-test/**"],
                "message": "@cofun/panel-test is the side panel's UI test harness: only an extension's tests and vitest.config.ts use it."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // Modules that send requests to Notion or Confluence, named by their paths (a tab.ts elsewhere, such
      // as in src/sidepanel/, is not exempt). Its import restrictions (the site block) still hold.
      "files": ["extensions/*/src/notion/tab.ts", "extensions/confluco/src/confluence/tab.ts"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // The one module that imports zod. Its other restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cofun/worker-client"],
                "allowTypeImports": true,
                "message": "Only the side panel's state (panel.ts, chat-session.ts) calls the worker: it gives the agent the client through @cofun/agent's hostedProvider and workerWeb, which turn a request the worker turned away into a stop of the question, and count what a call cost. Import its types only, or ask the agent (ToolContext.readWeb, searchWeb). Clerk sign-in is '@cofun/worker-client/clerk', and the credits in words '@cofun/worker-client/credits'."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["@cofun/analytics"],
                "message": "Only an extension's src/analytics.ts uses @cofun/analytics: it lists the extension's events. Call its track()."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "group": ["@cofun/panel-test", "@cofun/panel-test/**"],
                "message": "@cofun/panel-test is the side panel's UI test harness: only an extension's tests and vitest.config.ts use it."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The one module of an extension that uses @cofun/analytics, with the extension's events. Its other
      // restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/analytics.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cofun/worker-client"],
                "allowTypeImports": true,
                "message": "Only the side panel's state (panel.ts, chat-session.ts) calls the worker: it gives the agent the client through @cofun/agent's hostedProvider and workerWeb, which turn a request the worker turned away into a stop of the question, and count what a call cost. Import its types only, or ask the agent (ToolContext.readWeb, searchWeb). Clerk sign-in is '@cofun/worker-client/clerk', and the credits in words '@cofun/worker-client/credits'."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "group": ["@cofun/panel-test", "@cofun/panel-test/**"],
                "message": "@cofun/panel-test is the side panel's UI test harness: only an extension's tests and vitest.config.ts use it."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The shared libraries in packages/ that the extensions call. A package takes what is particular
      // to an extension as parameters and never imports one, and imports zod only through its own
      // src/zod.ts, which sets it up for the extensions' content security policy. Its tests (test/)
      // keep the restrictions of the first rules.
      "files": ["packages/*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only @cofun/analytics (packages/analytics/src/index.ts) imports the PostHog SDK. Call the extension's track() (src/analytics.ts), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the package's src/zod.ts: it sets zod up for the extensions' content security policy before any schema is built."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "A package never imports what is outside it, such as an extension: an extension calls it, and passes it what it needs as parameters."
              }
            ]
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "In a package, only @cofun/tools's tab.ts, duckduckgo/tab.ts, and youtube/tab.ts use chrome.scripting: they read the page or video a tab shows. Use what they export."
          }
        ]
      }
    },
    {
      // The one module that imports the PostHog SDK: @cofun/analytics, which sends an extension's own
      // events and nothing the SDK would add. Its other restrictions (the packages/*/src block) still
      // hold. No other package depends on it, and pnpm resolves only declared dependencies.
      "files": ["packages/analytics/src/index.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only @cofun/agent (packages/agent/src/) imports pi. Use what @cofun/agent exports, or add it there."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the package's src/zod.ts: it sets zod up for the extensions' content security policy before any schema is built."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "A package never imports what is outside it, such as an extension: an extension calls it, and passes it what it needs as parameters."
              }
            ]
          }
        ]
      }
    },
    {
      // @cofun/tools sends no request of its own: it reads pages in the user's tabs, and asks the agent,
      // which asks the worker, for web pages by their address and searches. The one exception is
      // youtube/tab.ts, below, whose requests run inside the user's YouTube tab. Its other
      // restrictions (the packages/*/src block) still hold.
      "files": ["packages/tools/src/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "@cofun/tools reads the web only through the user's tabs (chrome.scripting) and the agent (ToolContext.readWeb, searchWeb), which asks the worker: it sends no request itself, but from inside a YouTube tab (youtube/tab.ts)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
