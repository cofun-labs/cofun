// The extensions' module boundaries (AGENTS.md: "Architecture" and "Calling outside services"), as lint errors.
// Oxlint's default rules stay on: this file only adds rules.
//
// Each rule is written once for every extension, with extensions/*/ globs: an extension is
// extensions/<name>/, and it reaches its site only through src/<site>/tab.ts (src/notion/tab.ts in
// Notico). What every extension shares and is not UI (the agent and its providers, the worker's
// client, credits, sessions, sign-in hosts, zod) is packages/base/ (@cofun/base), which knows no site
// and no extension.
//
// An override replaces a rule's whole configuration, it does not merge with the one before it. So
// each block below repeats the restrictions that still hold for its files, and a later block wins.
//
// Oxlint's regexes have no lookahead (a pattern with one is ignored without a warning), so the rule
// that an extension never imports another one is written per place: in src/, a relative path that
// climbs to another folder's src/ or test/ (src/ is up to two levels deep, so the depth is not
// known); in test/ and browser-test/, a path that climbs two levels, to the extensions/ folder (the
// worker, which tests run against, is three levels up); in the extension's root files, one level. A package
// name can't reach another extension: no extension depends on another, and pnpm resolves only
// declared dependencies.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // Everywhere in the repository, tests included. packages/base/src/agent/ is exempted below for pi,
    // and extensions/*/src/analytics.ts for the PostHog SDK.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@earendil-works/pi-agent-core",
              "@earendil-works/pi-agent-core/**",
              "@earendil-works/pi-ai",
              "@earendil-works/pi-ai/**"
            ],
            "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
          },
          {
            "group": ["posthog-js", "posthog-js/**"],
            "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["extensions/**", "packages/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // An extension's own root files (manifest.ts, vite.config.ts, vitest.config.ts): one level
      // up is extensions/.
      "files": ["extensions/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^\\.\\./[^./]",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              }
            ]
          }
        ]
      }
    },
    {
      // An extension's tests, which sit directly in test/ (vitest) and browser-test/ (Playwright).
      "files": ["extensions/*/test/**", "extensions/*/browser-test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^\\.\\./\\.\\./[^./]",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["extensions/*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from @cofun/base/zod: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only @cofun/base/agent calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "Only an extension's src/<site>/tab.ts uses chrome.scripting: it is how requests run inside the user's tab. Use the helpers tab.ts exports."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only @cofun/base/agent calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only @cofun/base/agent calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only @cofun/base/agent calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ]
      }
    },
    {
      // The site layer knows nothing about the agent, the tools, sessions, or the UI. One directory
      // per site: src/sidepanel/ sits next to them and is not one, so each site is named here
      // (Notico's are Notion, and src/web/ for the page of a tab on any other site).
      "files": ["extensions/*/src/notion/**", "extensions/*/src/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^(\\.\\./)+(tool|tools|sidepanel)(\\.|/|$)",
                "message": "An extension's site layer (src/notion/ and src/web/ in Notico) imports nothing from the agent, tool.ts, tools/, sessions, or sidepanel/: those modules depend on the site layer, not the other way round."
              },
              {
                "group": ["@cofun/base/agent", "@cofun/base/sessions"],
                "message": "An extension's site layer (src/notion/ and src/web/ in Notico) imports nothing from the agent, tool.ts, tools/, sessions, or sidepanel/: those modules depend on the site layer, not the other way round."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from @cofun/base/zod: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              }
            ]
          }
        ]
      }
    },
    {
      // The one module that sends requests to Notion, named by its path (a tab.ts elsewhere, such
      // as in src/sidepanel/, is not exempt). Its import restrictions (the site block) still hold.
      "files": ["extensions/*/src/notion/tab.ts"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // The site layer for any other site reads the page in the user's tab with chrome.scripting,
      // and sends no request to the site, so fetch stays off limits here. Its import restrictions
      // (the site block) still hold.
      "files": ["extensions/*/src/web/tab.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (@cofun/base/agent)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (@cofun/base/agent)."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (@cofun/base/agent)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (@cofun/base/agent)."
          }
        ]
      }
    },
    {
      // The one module that imports the PostHog SDK. Its other restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/analytics.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from @cofun/base/zod: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: what extensions share and is not UI is in @cofun/base (packages/base/)."
              }
            ]
          }
        ]
      }
    },
    {
      // The worker imports zod through the module that sets it up, like the extensions.
      "files": ["worker/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import zod from worker/src/zod.ts (import * as z from './zod'): it sets zod up before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // The one module of the worker that imports zod.
      "files": ["worker/src/zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              }
            ]
          }
        ]
      }
    },
    {
      // @cofun/base: what every extension shares and is not UI. It knows no extension and no site, holds
      // no React and no sign-in UI, and only its src/agent/ sends requests.
      "files": ["packages/base/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from packages/base/src/zod.ts: it sets zod up for the extensions' content security policy before any schema is built."
              },
              {
                "group": ["react", "react/**", "react-dom", "react-dom/**", "@clerk/**"],
                "message": "@cofun/base holds no UI and no sign-in UI: the side panel, and what it shows, stay in each extension."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              },
              {
                "group": ["notico-extension", "notico-extension/**"],
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Only packages/base/src/agent/ sends requests: to the worker, and to a model provider the user chose. Nothing else in @cofun/base calls a service."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "@cofun/base knows no site: requests to a site run in the extension's src/<site>/tab.ts."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Only packages/base/src/agent/ sends requests: to the worker, and to a model provider the user chose. Nothing else in @cofun/base calls a service."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Only packages/base/src/agent/ sends requests: to the worker, and to a model provider the user chose. Nothing else in @cofun/base calls a service."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Only packages/base/src/agent/ sends requests: to the worker, and to a model provider the user chose. Nothing else in @cofun/base calls a service."
          }
        ]
      }
    },
    {
      // The one folder of @cofun/base that imports pi and sends requests: the agent, the worker's client,
      // and the user's own model provider.
      "files": ["packages/base/src/agent/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from packages/base/src/zod.ts: it sets zod up for the extensions' content security policy before any schema is built."
              },
              {
                "group": ["react", "react/**", "react-dom", "react-dom/**", "@clerk/**"],
                "message": "@cofun/base holds no UI and no sign-in UI: the side panel, and what it shows, stay in each extension."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              },
              {
                "group": ["notico-extension", "notico-extension/**"],
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              }
            ]
          }
        ],
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "@cofun/base knows no site: requests to a site run in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // The one module that imports zod. Its other restrictions (the packages/base/src block) still hold.
      "files": ["packages/base/src/zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "group": ["react", "react/**", "react-dom", "react-dom/**", "@clerk/**"],
                "message": "@cofun/base holds no UI and no sign-in UI: the side panel, and what it shows, stay in each extension."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              },
              {
                "group": ["notico-extension", "notico-extension/**"],
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              }
            ]
          }
        ]
      }
    },
    {
      // The package's own tests, of what it does without an extension (an extension's tests cover the rest).
      "files": ["packages/base/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only packages/base/src/agent/ imports pi. Import what you need from @cofun/base/agent (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              },
              {
                "group": ["notico-extension", "notico-extension/**"],
                "message": "@cofun/base knows no extension: an extension imports the package, never the other way round."
              }
            ]
