            "object": "self",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          }
        ]
      }
    },
    {
      // The one module that imports zod. Its other restrictions (the extension's code block) still hold.
      "files": ["extension/src/zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
