// The extensions' module boundaries (AGENTS.md: "Architecture" and "Calling outside services"), as lint errors.
// Oxlint's default rules stay on: this file only adds rules.
//
// Each rule is written once for every extension, with extensions/*/ globs: an extension is
// extensions/<name>/, and it reaches its site only through src/<site>/tab.ts (src/notion/tab.ts in
// Notico).
//
// An override replaces a rule's whole configuration, it does not merge with the one before it. So
// each block below repeats the restrictions that still hold for its files, and a later block wins.
//
// Oxlint's regexes have no lookahead (a pattern with one is ignored without a warning), so the rule
// that an extension never imports another one is written per place: in src/, a relative path that
// climbs to another folder's src/ or test/ (src/ is up to two levels deep, so the depth is not
// known); in test/ and browser-test/, a path that climbs two levels, to the extensions/ folder (the
// worker, which tests run against, is three levels up); in the extension's root files, one level. A package
// name can't reach another extension: no extension depends on another, and pnpm resolves only
// declared dependencies.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // Everywhere in the repository, tests included. extensions/*/src/agent/ is exempted below for pi,
    // and extensions/*/src/analytics.ts for the PostHog SDK.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@earendil-works/pi-agent-core",
              "@earendil-works/pi-agent-core/**",
              "@earendil-works/pi-ai",
              "@earendil-works/pi-ai/**"
            ],
            "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
          },
          {
            "group": ["posthog-js", "posthog-js/**"],
            "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["extensions/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // An extension's own root files (manifest.ts, vite.config.ts, vitest.config.ts): one level
      // up is extensions/.
      "files": ["extensions/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^\\.\\./[^./]",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // An extension's tests, which sit directly in test/ (vitest) and browser-test/ (Playwright).
      "files": ["extensions/*/test/**", "extensions/*/browser-test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^\\.\\./\\.\\./[^./]",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["extensions/*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "Only an extension's src/<site>/tab.ts uses chrome.scripting: it is how requests run inside the user's tab. Use the helpers tab.ts exports."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ]
      }
    },
    {
      // The side panel's state outside React: one ChatSession per chat, and the Panel that holds the
      // open one. React subscribes to them, so they import no React, nor anything that renders. Their
      // other restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/sidepanel/chat-session.ts", "extensions/*/src/sidepanel/panel.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "@clerk/chrome-extension",
                  "@clerk/chrome-extension/**"
                ],
                "message": "The side panel's ChatSession and Panel import no React: React subscribes to them (subscribe, getSnapshot). Keep what renders in the components."
              },
              {
                "regex": "^\\./[A-Z]",
                "message": "The side panel's ChatSession and Panel import no component (the side panel's modules named with a capital): a type both use goes in chat-session.ts or panel.ts."
              },
              {
                "group": ["./icons", "./menu", "./main"],
                "message": "The side panel's ChatSession and Panel import no React: these side-panel modules render or are hooks. A type both use goes in chat-session.ts or panel.ts."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The site layer knows nothing about the agent, the tools, sessions, or the UI. One directory
      // per site: src/sidepanel/ sits next to them and is not one, so each site is named here
      // (Notico's are Notion, src/web/ for the page of a tab on any other site, and DuckDuckGo, the
      // free web search a user can choose).
      "files": [
        "extensions/*/src/notion/**",
        "extensions/confluco/src/confluence/**",
        "extensions/*/src/web/**",
        "extensions/notico/src/duckduckgo/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^(\\.\\./)+(agent|tool|tools|sessions|sidepanel)(\\.|/|$)",
                "message": "An extension's site layer (src/notion/ and src/web/ in Notico) imports nothing from agent/, tool.ts, tools/, sessions.ts, or sidepanel/: those modules depend on the site layer, not the other way round."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The one folder that imports pi, and the one that calls the worker: the agent, src/agent/.
      "files": ["extensions/*/src/agent/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ],
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "Only an extension's src/<site>/tab.ts uses chrome.scripting: it is how requests run inside the user's tab. Use the helpers tab.ts exports."
          }
        ]
      }
    },
    {
      // Modules that send requests to Notion, Confluence, or DuckDuckGo, named by their paths (a tab.ts elsewhere, such
      // as in src/sidepanel/, is not exempt). Its import restrictions (the site block) still hold.
      "files": [
        "extensions/*/src/notion/tab.ts",
        "extensions/confluco/src/confluence/tab.ts",
        "extensions/notico/src/duckduckgo/search.ts"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // The site layer for any other site reads the page in the user's tab with chrome.scripting,
      // and sends no request to the site, so fetch stays off limits here. Its import restrictions
      // (the site block) still hold.
      "files": ["extensions/*/src/web/tab.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          }
        ]
      }
    },
    {
      // The one module that imports zod. Its other restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The one module that imports the PostHog SDK. Its other restrictions (the extensions/*/src block) still hold.
      "files": ["extensions/*/src/analytics.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              },
              {
                "regex": "^(\\.\\./)+[^./][^/]*/(src|test)(/|$)",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              },
              {
                "regex": "^(\\.\\./)+extensions/",
                "message": "An extension never imports another extension: each one in extensions/<name>/ keeps its own copy of what it needs."
              }
            ]
          }
        ]
      }
    },
    {
      // The worker imports zod through the module that sets it up, like the extensions.
      "files": ["worker/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import zod from worker/src/zod.ts (import * as z from './zod'): it sets zod up before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // The one module of the worker that imports zod.
      "files": ["worker/src/zod.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              }
            ]
          }
        ]
      }
    }
  ]
}
