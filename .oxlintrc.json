// The extension's module boundaries (AGENTS.md: "Architecture" and "Calling outside services"), as lint errors.
// Oxlint's default rules stay on: this file only adds rules.
//
// Every product is built from the one package in extension/: the code they share is in src/, and
// each product's own files in products/<name>/. A product reaches its site only through
// src/<site>/tab.ts (src/notion/tab.ts for Notico).
//
// An override replaces a rule's whole configuration, it does not merge with the one before it. So
// each block below repeats the restrictions that still hold for its files, and a later block wins.
//
// Oxlint's regexes have no lookahead (a pattern with one is ignored without a warning), so the rule
// that a product never imports another one is written for where a product's files are: directly in
// products/<name>/, so one level up is products/; a path that climbs further and comes back down
// through products/ names a product too (a product's own files never import through products/).
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    // Everywhere in the repository, tests included. extension/src/agent/ is exempted below for pi,
    // and extension/src/analytics.ts for the PostHog SDK.
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@earendil-works/pi-agent-core",
              "@earendil-works/pi-agent-core/**",
              "@earendil-works/pi-ai",
              "@earendil-works/pi-ai/**"
            ],
            "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
          },
          {
            "group": ["posthog-js", "posthog-js/**"],
            "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["extension/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // The extension's code: what every product shares, in src/, and each product's own, in
      // products/<name>/.
      "files": ["extension/src/**", "extension/products/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "Only an extension's src/<site>/tab.ts uses chrome.scripting: it is how requests run inside the user's tab. Use the helpers tab.ts exports."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "window",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          },
          {
            "object": "self",
            "property": "fetch",
            "message": "Only an extension's src/<site>/tab.ts sends requests to its site, and only its src/agent/ calls the worker. Tools call the typed methods of the site's client (src/notion/api.ts in Notico)."
          }
        ]
      }
    },
    {
      // A product's own files, directly in products/<name>/: one level up is products/, so a path
      // that climbs one level and goes down again names another product. Its other restrictions
      // (the extension's code block) still hold.
      "files": ["extension/products/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./[^./]",
                "message": "A product never imports another product: each one in extension/products/<name>/ builds on the shared code in src/, and keeps its own copy of anything else it needs."
              },
              {
                "regex": "^(\\.\\./)+([^/]+/)*products/",
                "message": "A product never imports another product: each one in extension/products/<name>/ builds on the shared code in src/, and keeps its own copy of anything else it needs."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // Code every product shares: the side panel, the agent, usage data, sessions, and the helpers
      // they use. It reads the site, its tools, and the product's name through the product
      // (src/product.ts), which the entry points give it; the blocks below that repeat the pattern
      // (src/agent/, chat-session.ts and panel.ts, src/analytics.ts) hold it too. Its other
      // restrictions (the extension's code block) still hold.
      // The Notion tool modules are named both as tools/<name> and as ./<name>, which is how
      // src/tools/index.ts, listed here, would import them.
      "files": [
        "extension/src/sidepanel/**",
        "extension/src/agent/**",
        "extension/src/analytics.ts",
        "extension/src/clerk.ts",
        "extension/src/credits.ts",
        "extension/src/mode.ts",
        "extension/src/models.ts",
        "extension/src/product.ts",
        "extension/src/prompt.ts",
        "extension/src/selection.ts",
        "extension/src/sessions.ts",
        "extension/src/tool.ts",
        "extension/src/tools/index.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/(\\.\\./)*(notion(/|$)|tools/(read|write|database|organize|comments|find|save|current|notion-tabs|load)$|products/)|^\\./(read|write|database|organize|comments|find|save|current|notion-tabs|load)$",
                "message": "Code every product shares (the side panel, the agent, usage data, sessions) reaches the site only through the product (src/product.ts): it imports nothing from src/notion/, the Notion tools, or a product's folder (products/<name>/). Only the entry points (src/sidepanel/main.tsx, src/background.ts) pick the product."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // The side panel's entry point picks the product and gives it to the panel, so it may import
      // the product's definition. Its other restrictions (the extension's code block) still hold.
      "files": ["extension/src/sidepanel/main.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // The side panel's state outside React: one ChatSession per chat, and the Panel that holds the
      // open one. React subscribes to them, so they import no React, nor anything that renders. Their
      // other restrictions (the extension's code block) still hold.
      "files": ["extension/src/sidepanel/chat-session.ts", "extension/src/sidepanel/panel.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/(\\.\\./)*(notion(/|$)|tools/(read|write|database|organize|comments|find|save|current|notion-tabs|load)$|products/)|^\\./(read|write|database|organize|comments|find|save|current|notion-tabs|load)$",
                "message": "Code every product shares (the side panel, the agent, usage data, sessions) reaches the site only through the product (src/product.ts): it imports nothing from src/notion/, the Notion tools, or a product's folder (products/<name>/). Only the entry points (src/sidepanel/main.tsx, src/background.ts) pick the product."
              },
              {
                "group": [
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "@clerk/chrome-extension",
                  "@clerk/chrome-extension/**"
                ],
                "message": "The side panel's ChatSession and Panel import no React: React subscribes to them (subscribe, getSnapshot). Keep what renders in the components."
              },
              {
                "regex": "^\\./[A-Z]",
                "message": "The side panel's ChatSession and Panel import no component (the side panel's modules named with a capital): a type both use goes in chat-session.ts or panel.ts."
              },
              {
                "group": ["./icons", "./menu", "./main"],
                "message": "The side panel's ChatSession and Panel import no React: these side-panel modules render or are hooks. A type both use goes in chat-session.ts or panel.ts."
              },
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // The site layer knows nothing about the agent, the tools, sessions, or the UI. One directory
      // per site: src/sidepanel/ sits next to them and is not one, so each site is named here
      // (Notico's are Notion, and src/web/ for the page of a tab on any other site).
      "files": ["extension/src/notion/**", "extension/src/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/pi-agent-core",
                  "@earendil-works/pi-agent-core/**",
                  "@earendil-works/pi-ai",
                  "@earendil-works/pi-ai/**"
                ],
                "message": "Only an extension's src/agent/ imports pi. Import what you need from src/agent/ (its index.ts), or add it there."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^(\\.\\./)+(agent|tool|tools|sessions|sidepanel)(\\.|/|$)",
                "message": "An extension's site layer (src/notion/ and src/web/ in Notico) imports nothing from agent/, tool.ts, tools/, sessions.ts, or sidepanel/: those modules depend on the site layer, not the other way round."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ]
      }
    },
    {
      // The one folder that imports pi, and the one that calls the worker: the agent, src/agent/.
      "files": ["extension/src/agent/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/(\\.\\./)*(notion(/|$)|tools/(read|write|database|organize|comments|find|save|current|notion-tabs|load)$|products/)|^\\./(read|write|database|organize|comments|find|save|current|notion-tabs|load)$",
                "message": "Code every product shares (the side panel, the agent, usage data, sessions) reaches the site only through the product (src/product.ts): it imports nothing from src/notion/, the Notion tools, or a product's folder (products/<name>/). Only the entry points (src/sidepanel/main.tsx, src/background.ts) pick the product."
              },
              {
                "group": ["posthog-js", "posthog-js/**"],
                "message": "Only an extension's src/analytics.ts imports the PostHog SDK. Call its track(), whose events are the only ones that can be sent."
              },
              {
                "regex": "^zod(/|$)",
                "message": "Import z from the extension's src/zod.ts: it sets zod up for the extension's content security policy before any schema is built."
              }
            ]
          }
        ],
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "chrome",
            "property": "scripting",
            "message": "Only an extension's src/<site>/tab.ts uses chrome.scripting: it is how requests run inside the user's tab. Use the helpers tab.ts exports."
          }
        ]
      }
    },
    {
      // The one module that sends requests to Notion, named by its path (a tab.ts elsewhere, such
      // as in src/sidepanel/, is not exempt). Its import restrictions (the site block) still hold.
      "files": ["extension/src/notion/tab.ts"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          }
        ]
      }
    },
    {
      // The site layer for any other site reads the page in the user's tab with chrome.scripting,
      // and sends no request to the site, so fetch stays off limits here. Its import restrictions
      // (the site block) still hold.
      "files": ["extension/src/web/tab.ts"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "chrome",
            "property": "debugger",
            "message": "Never use chrome.debugger: it shows a permanent \"debugging this browser\" banner. Site requests run through chrome.scripting in the extension's src/<site>/tab.ts."
          },
          {
            "object": "globalThis",
            "property": "fetch",
            "message": "src/web/tab.ts only reads the page a tab already shows: it sends no request to the site. A web page is read by its address through the worker (src/agent/)."
          },
