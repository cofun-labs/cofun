            "patterns": [
              {
                "regex": "^\\.{1,2}/(\\.\\./)*(notion(/|$)|tools/(read|write|database|organize|comments|find|save|current|notion-tabs|load)$|products/)|^\\./(read|write|database|organize|comments|find|save|current|notion-tabs|load)$",
                "message": "Code every product shares (the side panel, the agent, usage data, sessions) reaches the site only through the product (src/product.ts): it imports nothing from src/notion/, the Notion tools, or a product's folder (products/<name>/). Only the entry points (src/sidepanel/main.tsx, src/background.ts) pick the product."
              },
