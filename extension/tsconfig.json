{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["chrome", "vite/client", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "browser-test",
    "browser-driver",
    "products",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "manifest.ts"
  ]
}
