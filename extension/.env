# Public build config for the hosted Copilot for Notion. None of these are secrets.
# Override any of them in .env.local (git-ignored) to point at your own deployment.

# Clerk publishable key (Clerk Dashboard > API keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuY29mdW4uY2Mk

# Web page where users sign in (served by the worker). Clerk syncs its session into the extension:
# from this host on a development instance, from the Frontend API host on a production one.
VITE_CLERK_SYNC_HOST=https://api.cofun.cc

# Worker base URL, including /v1
VITE_API_URL=https://api.cofun.cc/v1

# Public half of the extension signing key. Fixes the extension ID so Clerk and the
# worker can allow it. See docs/development.md to generate your own.
CRX_PUBLIC_
