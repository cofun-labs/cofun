{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofun-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serves the API and the sign-in page (Clerk Sync Host). The zone must be on the deploying account.
  "routes": [{ "pattern": "api.cofun.cc", "custom_domain": true }],
  "workers_dev": false,

  // Workers Logs: keep console output and per-request invocation logs in the dashboard.
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
  },

  // Workers AI: models run on Cloudflare, no external API keys.
  "ai": { "binding": "AI" },

  // Every user's credits: grants, and model calls with what each cost; the schema is in migrations/
  // (see "Database" in docs/development.md).
  // The database is found by its name on the deploying account, so its id is not kept here.
  "d1_databases": [{ "binding": "DB", "database_name": "cofun-db", "migrations_dir": "migrations" }],

  // Per-user caps, keyed by user id. A namespace id is any number unique on the account.
  // CHAT_LIMIT: how many chat requests one user can start a minute, which bounds what calls sent at
  // once can cost beyond the user's credits (forgiven, never owed). Normal use, one question's
  // calls one after another, stays far below it.
  // API_LIMIT: how many requests one user can make a minute to every other route under /v1 (their
  // credits, buying, the admin routes), so one account cannot keep D1 or Stripe busy. Normal use is
  // a few a minute: the side panel reads the credits when it loads, after each question, when the
  // account menu or the settings open, and on coming back from Checkout; several windows multiply
  // that, and still stay far below it.
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    // WEB_LIMIT: how many web pages one user can have the worker read or render a minute, so one
    // account cannot use it to send many requests to a site. A question reads a few at most.
    { "name": "WEB_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    // RENDER_LIMIT: how many of those pages one user can have rendered in Browser Run a minute.
    // Renders are charged the browser time they use, but those sent at once all start on the same
    // balance, so this bounds what they can cost beyond it: up to 0.75 credit each (a 30 s timeout).
    // A question renders one or two at most.
    { "name": "RENDER_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // SEARCH_LIMIT: how many web searches one user can make a minute. Searches are charged 0.25
    // credit each, but those sent at once all start on the same balance, so this bounds what they
    // can cost beyond it. A question searches a few times at most.
    { "name": "SEARCH_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
  ],

  // Browser Run: renders the pages the extension asks for that are drawn by scripts (routes/web.ts).
  "browser": { "binding": "BROWSER" },

  // Per-request usage records (sizes, token counts, credits charged, outcome; never message content).
  // Workers Analytics Engine keeps them for 90 days. The dataset is created on first write.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "cofun_api_usage" }],

  "vars": {
    // Clerk publishable key, for the sign-in page. Public.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuY29mdW4uY2Mk",
    // AI Gateway id (dashboard: AI > AI Gateway). Empty = call Workers AI directly.
    "AI_GATEWAY_ID": "cofun-ai-gateway",
    // The only model clients can use. Its token prices must be listed in src/pricing.ts.
    "MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
    // Origins allowed to call (the token's azp claim). Comma-separated.
    "CLERK_AUTHORIZED_PARTIES": "chrome-extension://moblfnjjebknafkgoifncombfnbfghom,https://api.cofun.cc,chrome-extension://fccfdaiibgaiblpkkmpfgoijmokbgfng",
    // What is on sale: the live Stripe price of 1,000 credits for US$1 (one product, "Cofun Credits"),
    // and the quantities of it sold as packs: US$1, 5, 20, and 100. Price ids are not secret.
    // STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are worker secrets, never kept here (see
    // "Worker" in docs/development.md).
    "CREDIT_PRICE": "price_1UbLSMCT6MhL4FCmD4mRe680",
    "CREDIT_PACKS": [1, 5, 20, 100],
    // Product analytics: PostHog's ingestion host (US region) and the project's key (phc_…, public
    // by design; the same one as extensions/notico/.env). With the key empty, no event is sent.
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "POSTHOG_KEY": "phc_gO1i2DKlg9TOf0mme2DKkZ0EezWMZ0yNjXOFTDhBaNu",
    // Clerk JWT public key (PEM). Public; also served at https://<frontend-api>/.well-known/jwks.json
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAvmcyRgQuBYHuMrpM4d5N\nwQ9Y7i59S80hLM7Qd68gIpszm0Mi7eOIMmxTOVIePX4jsjf+ByfPl6qluXsPGik/\nwtr1ti37UUADTdC1qjn3jabY22UebFXgxp6Fq6XHJKelmHQBm77OwzZMPzPgmnwK\nM9nJuxXpsGtNH3a8xzC8Ql8UOJE5eWvgXKcu48b/Awja7J+yGQe7OklbaJL71FrJ\nPGUDS7bLVHvJP8/xTd3eii+LdqN5o7RDqwDu1wesJ9g2f8ykLfd55ykVZURr8R3w\n6Z46/wXqoufUn4CdRwsY19zNQlhruUMSGsRLn9PiYOfL1aBHZZzR/tLRndIFq9lY\nqQIDAQAB\n-----END PUBLIC KEY-----\n"
  }

}
